{
	"name": "@nylas-labs/cli-kit",
	"version": "0.7.0",
	"description": "Nylas dashboard device-flow auth (DPoP), domains REST, gateway GraphQL, and an edge-safe v3 API client",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nylas/labs.git",
		"directory": "shared/nylas-cli-kit"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./v3": {
			"types": "./dist/v3.d.ts",
			"default": "./dist/v3.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
