{
	"name": "@ownmail/app",
	"version": "0.12.7",
	"description": "The customizable OwnMail web app for mail, calendar, and contacts",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nylas/labs.git",
		"directory": "labs/ownmail/packages/app"
	},
	"type": "module",
	"imports": {
		"#app/components/*": "./src/app/components/*.tsx",
		"#app/config/*": "./src/app/config/*.ts",
		"#app/lib/*": "./src/app/lib/*.ts",
		"#app/preferences/*": "./src/app/preferences/*.ts",
		"#app/query/*": "./src/app/query/*.tsx",
		"#features/account/server/*": "./src/features/account/server/*.ts",
		"#features/auth/components/*": "./src/features/auth/components/*.tsx",
		"#features/calendar/components/*": "./src/features/calendar/components/*.tsx",
		"#features/calendar/lib/*": "./src/features/calendar/lib/*.ts",
		"#features/calendar/server/*": "./src/features/calendar/server/*.ts",
		"#features/calendar/state/*": "./src/features/calendar/state/*.ts",
		"#features/contacts/components/*": "./src/features/contacts/components/*.tsx",
		"#features/contacts/lib/*": "./src/features/contacts/lib/*.ts",
		"#features/contacts/server/*": "./src/features/contacts/server/*.ts",
		"#features/contacts/state/*": "./src/features/contacts/state/*.ts",
		"#features/mail/components/*": "./src/features/mail/components/*.tsx",
		"#features/mail/lib/*": "./src/features/mail/lib/*.ts",
		"#features/mail/server/*": "./src/features/mail/server/*.ts",
		"#features/mail/state/*": "./src/features/mail/state/*.ts",
		"#server/*": "./src/server/*.ts",
		"#shared/components/*": "./src/shared/components/*.tsx",
		"#shared/hooks/*": "./src/shared/hooks/*.ts",
		"#shared/lib/*": "./src/shared/lib/*.ts"
	},
	"files": [
		"README.md",
		"CHANGELOG.md",
		"components.json",
		"dist",
		"dist-vercel",
		".vercel/output",
		"src",
		"public",
		"scripts",
		"template.json",
		"vite.config.ts",
		"vite.config.local.ts",
		"vite.config.vercel.ts",
		"tsconfig.json",
		"wrangler.jsonc"
	],
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "OWNMAIL_DEV_MOCKS=1 SESSION_SECRET=ownmail-dev-session-secret-change-me NYLAS_API_KEY=dev NYLAS_CLIENT_ID=dev NYLAS_REGION=us APP_NAME=ownmail-dev INBOX_EMAIL=ada@ownmail.com TEMPLATE_VERSION=0.1.2 vite dev -c vite.config.local.ts --host 127.0.0.1",
		"dev:local": "vite dev -c vite.config.local.ts --host 127.0.0.1",
		"capture:readme": "node scripts/capture-readme-screenshots.mjs",
		"build": "pnpm build:cloudflare && pnpm build:node && pnpm build:vercel",
		"build:cloudflare": "vite build",
		"build:node": "vite build -c vite.config.local.ts --outDir dist-vercel",
		"build:vercel": "vite build -c vite.config.vercel.ts",
		"test": "vitest run --coverage",
		"coverage": "vitest run --coverage",
		"pretypecheck": "pnpm --filter @nylas-labs/cli-kit build",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@nylas-labs/cli-kit": "workspace:*",
		"@nylas/connect": "^1.2.5",
		"@radix-ui/react-dialog": "^1.1.21",
		"@radix-ui/react-scroll-area": "^1.2.16",
		"@radix-ui/react-select": "^2.3.5",
		"@radix-ui/react-slot": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.2.14",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.32",
		"@upstash/redis": "^1.38.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.13",
		"lucide-react": "^1.26.0",
		"nitro": "3.0.260610-beta",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.47.0",
		"@cloudflare/workers-types": "^5.20260723.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/coverage-v8": "4.1.10",
		"jsdom": "^29.1.1",
		"playwright": "1.61.1",
		"sharp": "0.35.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	}
}
