{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Placeholder config used at build time and local dev. `ownmail` (the CLI)
	// patches name, kv id, and vars when materializing a user deploy.
	"name": "ownmail-template",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"kv_namespaces": [{ "binding": "SESSIONS", "id": "00000000000000000000000000000000" }],
	// Atomic invitation claims. KV has no compare-and-set, so each claim key is
	// owned by one Durable Object. Needs no account resource, so `ownmail
	// deploy` carries the binding and migration through unchanged.
	"durable_objects": { "bindings": [{ "name": "INVITATION_LOCKS", "class_name": "InvitationLocks" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["InvitationLocks"] }],
	// Sign-in brute-force limits. KV cannot back these: it has no atomic
	// increment and is eventually consistent, so a parallel burst would slip
	// past. These bindings are atomic at the edge. `period` accepts only 10 or
	// 60 seconds, so the per-mailbox and per-address budgets are per minute.
	// They need no account resource, so `ownmail deploy` carries them through
	// unchanged.
	"ratelimits": [
		{ "name": "SIGNIN_EMAIL_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "SIGNIN_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
	],
	"vars": {
		"NYLAS_CLIENT_ID": "dev-client-id",
		"NYLAS_REGION": "us",
		"APP_NAME": "ownmail-dev",
		"INBOX_EMAIL": "",
		"TEMPLATE_VERSION": "0.1.1"
	},
	"observability": { "enabled": true }
}
