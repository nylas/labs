{
	"name": "nylas-labs",
	"private": true,
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"smoke:ownmail-release": "node labs/ownmail/scripts/smoke-release.mjs",
		"commit:check": "node scripts/check-commit-message.mjs",
		"changeset": "changeset",
		"release": "turbo build && changeset publish",
		"stage-release": "turbo build && node scripts/stage-release.mjs",
		"create-lab": "node scripts/create-lab.mjs",
		"banner": "node scripts/create-banner.mjs",
		"prepare": "node scripts/install-git-hooks.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.0",
		"@changesets/cli": "^2.29.0",
		"turbo": "^2.5.0",
		"typescript": "^7.0.0"
	}
}
