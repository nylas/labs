{
  "name": "mcp-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=@nylas/mcp-bot-api",
    "dev:deps": "docker-compose up -d",
    "dev:deps:ui": "docker-compose --profile ui up -d",
    "dev:deps:down": "docker-compose down",
    "dev:logs": "docker-compose logs -f",
    "dev:full": "npm run dev:deps && npm run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/node": "^24.0.1",
    "eslint": "^9.26.0",
    "prettier": "^3.2.4",
    "typescript": "^5.4.0"
  }
}
