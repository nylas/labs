		{
			"name": "OAuth Flow",
			"item": [
				{
					"name": "Start OAuth Redirect",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/connect/redirect",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"connect",
								"redirect"
							]
						},
						"description": "Initiates OAuth flow - will redirect to Nylas OAuth page"
					},
					"response": []
				},
				{
					"name": "OAuth Callback (Simulation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data) {",
									"        if (response.data.grant_id) {",
									"            pm.environment.set('grant_id', response.data.grant_id);",
									"            console.log('Grant ID saved:', response.data.grant_id);",
									"        }",
									"        if (response.data.api_key) {",
									"            pm.environment.set('api_key', response.data.api_key);",
									"            console.log('API Key saved to environment');",
									"        }",
									"    }",
									"    console.log('OAuth callback successful');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/callback?code=mock_auth_code&state=mock_state",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"callback"
							],
							"query": [
								{
									"key": "code",
									"value": "mock_auth_code",
									"description": "OAuth authorization code from Nylas"
								},
								{
									"key": "state",
									"value": "mock_state",
									"description": "State parameter for CSRF protection"
								}
							]
						},
						"description": "OAuth callback endpoint - normally called by Nylas after user authorization. Automatically saves grant_id and api_key to environment variables."
					},
					"response": []
				},
				{
					"name": "Get Current User Info",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{api_key}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Get current authenticated user information including grant_id, email, provider, org_id, and timezone. The timezone field is automatically fetched from the user's primary calendar and used for automatic timezone detection in the Calendar MCP Server."
					},
					"response": []
				},
				{
					"name": "Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.access_token) {",
									"        console.log('Access token refreshed successfully');",
									"        console.log('New expires_in:', response.data.expires_in);",
									"        if (response.data.refresh_token && response.data.refresh_token !== pm.environment.get('refresh_token')) {",
									"            pm.environment.set('refresh_token', response.data.refresh_token);",
									"            console.log('New refresh token saved to environment');",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"description": "Refresh access token using a refresh token. Can use either cookies (automatic) or provide refresh_token in request body. Returns new access_token, refresh_token, and other token information."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Logout user by clearing access token and refresh token cookies. Requires no authentication."
					},
					"response": []
				}
			],
			"description": "OAuth authentication flow endpoints"
		},
