# Nylas API Configuration
NYLAS_API_KEY=your_nylas_api_key_here
NYLAS_API_URI=https://api.nylas.com
NYLAS_CLIENT_ID=your_nylas_client_id_here

# MCP Server Configuration
# Calendar MCP Server URL (additional MCP servers can be added here in the future)
NEXT_PUBLIC_CALENDAR_MCP_SERVER_URL=http://localhost:3002

# Redis/KV Configuration
# New KV environment variables (preferred)
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_rest_api_read_only_token_here
KV_URL=your_kv_redis_url_here
REDIS_URL=your_redis_url_here

# Legacy Upstash Redis Configuration (for backward compatibility)
UPSTASH_REDIS_REST_URL=your_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# MCP Server
NEXT_PUBLIC_CALENDAR_MCP_SERVER_URL=http://localhost:3002

# JWT Secret (will be auto-generated if not provided)
MCP_JWT_SECRET=your_jwt_secret_here 

# OpenAI API Configuration (required for AI SDK)
OPENAI_API_KEY=your_openai_api_key_here 