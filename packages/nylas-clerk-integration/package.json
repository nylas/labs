{
  "name": "nylas-clerk-integration",
  "version": "1.0.0",
  "description": "A reusable SDK for integrating Nylas with Clerk authentication in Next.js applications",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nylas-clerk-integration": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run typecheck && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "nylas",
    "clerk",
    "authentication",
    "nextjs",
    "react",
    "calendar",
    "integration",
    "typescript",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylas/labs.git",
    "directory": "packages/nylas-clerk-integration"
  },
  "bugs": {
    "url": "https://github.com/nylas/labs/issues"
  },
  "homepage": "https://github.com/nylas/labs/tree/main/packages/nylas-clerk-integration#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@clerk/backend": "^2.0.0",
    "@clerk/nextjs": "^6.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "nylas": "^7.0.0",
    "sonner": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^12.0.0",
    "@inquirer/prompts": "^5.0.0",
    "@clerk/backend": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
